{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Weekly meal plan",
  "type": "object",
  "required": ["recipes"],
  "properties": {
    "week_label": { "type": "string", "description": "Informational only, e.g. 2026-W29" },
    "servings":   { "type": "integer", "minimum": 1, "default": 2, "description": "Default number of participants (portions) per meal; overridable per recipe" },
    "author":     { "type": "string", "description": "Recipe author; required by Bring! import. Defaults to MealAI if omitted" },
    "meal_times": {
      "type": "object",
      "description": "Optional plan-level overrides for the serving time of each meal category. Missing entries fall back to the defaults (breakfast 09:00, lunch 12:00, dinner 19:30, other 15:00). A recipe's own 'time' takes precedence over these.",
      "additionalProperties": false,
      "properties": {
        "breakfast": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "default": "09:00" },
        "lunch":     { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "default": "12:00" },
        "dinner":    { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "default": "19:30" },
        "other":     { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "default": "15:00" }
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "name", "ingredients", "steps"],
        "properties": {
          "date":     { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Meal date; drives the year/month/week folder. Several recipes may share a date (e.g. breakfast + lunch + dinner)" },
          "name":     { "type": "string" },
          "author":   { "type": "string", "description": "Overrides plan-level author for this recipe" },
          "meal":     { "type": "string", "enum": ["breakfast", "lunch", "dinner", "other"], "default": "dinner", "description": "Meal category for the day; determines the default serving time and the ordering within a day" },
          "time":     { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "description": "Serving/eating time HH:MM for this meal. Overrides meal_times[meal] and the category default. The cooking calendar event ends at this time" },
          "type":     { "type": "string", "enum": ["meat", "vegetarian", "fish"], "default": "meat" },
          "prep_min": { "type": "integer", "minimum": 0 },
          "cook_min": { "type": "integer", "minimum": 0 },
          "servings": { "type": "integer", "minimum": 1, "description": "Number of participants (portions) for this meal; overrides plan-level servings" },
          "image":    { "type": "string" },
          "category": { "type": "string" },
          "tagline":  { "type": "string" },
          "ingredients": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "amount": { "type": ["number", "string", "null"] },
                "unit":   { "type": ["string", "null"] },
                "name":   { "type": "string" }
              }
            }
          },
          "steps": { "type": "array", "items": { "type": "string" } },
          "tips":  { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
