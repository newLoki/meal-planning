{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Weekly meal plan",
  "type": "object",
  "required": ["recipes"],
  "properties": {
    "week_label": { "type": "string", "description": "Informational only, e.g. 2026-W29" },
    "servings":   { "type": "integer", "minimum": 1, "default": 2 },
    "author":     { "type": "string", "description": "Recipe author; required by Bring! import. Defaults to MealAI if omitted" },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "name", "ingredients", "steps"],
        "properties": {
          "date":     { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Dinner date; drives the year/month/week folder" },
          "name":     { "type": "string" },
          "author":   { "type": "string", "description": "Overrides plan-level author for this recipe" },
          "type":     { "type": "string", "enum": ["meat", "vegetarian", "fish"], "default": "meat" },
          "prep_min": { "type": "integer", "minimum": 0 },
          "cook_min": { "type": "integer", "minimum": 0 },
          "servings": { "type": "integer", "minimum": 1, "description": "Overrides plan-level servings for this recipe" },
          "image":    { "type": "string" },
          "category": { "type": "string" },
          "tagline":  { "type": "string" },
          "ingredients": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "amount": { "type": ["number", "string", "null"] },
                "unit":   { "type": ["string", "null"] },
                "name":   { "type": "string" }
              }
            }
          },
          "steps": { "type": "array", "items": { "type": "string" } },
          "tips":  { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
