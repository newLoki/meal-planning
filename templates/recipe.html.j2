<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ r.name }}</title>
<style>
  :root{--fg:#1a1a1a;--muted:#6b6b6b;--accent:#d1021b;--bg:#fff;--card:#f5f4f1}
  *{box-sizing:border-box}
  body{margin:0;font:16px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;color:var(--fg);background:var(--bg)}
  main{max-width:640px;margin:0 auto;padding:24px 20px 72px}
  a.back{color:var(--muted);text-decoration:none;font-size:14px}
  h1{font-size:1.6rem;margin:.5em 0 .1em;line-height:1.2}
  .meta{color:var(--muted);font-size:14px;margin:.4em 0 1.4em}
  h2{font-size:1.02rem;margin:1.7em 0 .4em;border-bottom:1px solid #ececec;padding-bottom:.25em}
  ul,ol{padding-left:1.25em;margin:.4em 0}
  li{margin:.28em 0}
  img.hero{width:100%;border-radius:12px;margin:.6em 0}
  .tips{background:var(--card);border-radius:10px;padding:.4em 1em;margin-top:.6em}
  .bring{display:inline-block;margin-top:1.9em;background:var(--accent);color:#fff;text-decoration:none;font-weight:600;padding:.72em 1.2em;border-radius:10px}
  .bring:active{opacity:.85}
  footer{margin-top:2.6em;color:#b3b3b3;font-size:12px}
</style>
</head>
<body>
<main itemscope itemtype="http://schema.org/Recipe">
  <a class="back" href="./">&larr; Woche</a>
  <h1>{{ icon }} <span itemprop="name">{{ r.name }}</span></h1>
  <p class="meta">
    {% if r.prep_min or r.cook_min %}&#9201;&#65039; {{ r.prep_min + r.cook_min }} min ({{ r.prep_min }} Vorb. + {{ r.cook_min }} Koch) &middot; {% endif %}&#128101; <span itemprop="recipeYield">{{ servings }}</span> Portionen{% if r.author %} &middot; <span itemprop="author">{{ r.author }}</span>{% endif %}
  </p>
  <meta itemprop="yield" content="{{ servings }}">
  {% if r.prep_min %}<meta itemprop="prepTime" content="PT{{ r.prep_min }}M">{% endif %}
  {% if r.cook_min %}<meta itemprop="cookTime" content="PT{{ r.cook_min }}M">{% endif %}
  {% if r.prep_min or r.cook_min %}<meta itemprop="totalTime" content="PT{{ r.prep_min + r.cook_min }}M">{% endif %}
  {% if r.category %}<meta itemprop="recipeCategory" content="{{ r.category }}">{% endif %}
  {% if r.image %}<img class="hero" itemprop="image" src="{{ r.image }}" alt="{{ r.name }}">{% endif %}
  {% if r.tagline %}<p itemprop="description">{{ r.tagline }}</p>{% endif %}

  <h2>Zutaten</h2>
  <ul>
  {% for ing in ingredient_strings %}
    <li itemprop="recipeIngredient ingredients">{{ ing }}</li>
  {% endfor %}
  </ul>

  {% if r.steps %}
  <h2>Zubereitung</h2>
  <ol>
  {% for step in r.steps %}
    <li itemprop="recipeInstructions">{{ step }}</li>
  {% endfor %}
  </ol>
  {% endif %}

  {% if r.tips %}
  <h2>Tipps</h2>
  <div class="tips">
    <ul>
    {% for t in r.tips %}
      <li>{{ t }}</li>
    {% endfor %}
    </ul>
  </div>
  {% endif %}

  <a class="bring" href="{{ deeplink }}">&#128722; Zu Bring! hinzuf&uuml;gen</a>
  <footer>Generiert {{ built }} &middot; Quelle: {{ source_path }}</footer>
</main>
</body>
</html>
