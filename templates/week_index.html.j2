<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Woche {{ week }} &middot; {{ year }}</title>
<style>
  :root{--fg:#1a1a1a;--muted:#6b6b6b;--accent:#d1021b;--card:#f5f4f1}
  *{box-sizing:border-box}
  body{margin:0;font:16px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;color:var(--fg);background:#fff}
  main{max-width:640px;margin:0 auto;padding:24px 20px 72px}
  a.back{color:var(--muted);text-decoration:none;font-size:14px}
  h1{font-size:1.5rem;margin:.5em 0 1em}
  ul.cards{list-style:none;padding:0;margin:0}
  ul.cards li{background:var(--card);border-radius:12px;padding:14px 16px;margin:0 0 12px;display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 12px}
  ul.cards li a.title{font-weight:600;color:var(--fg);text-decoration:none;font-size:1.05rem}
  ul.cards li .d{color:var(--muted);font-size:13px}
  a.bring{margin-left:auto;background:var(--accent);color:#fff;text-decoration:none;font-weight:600;padding:.4em .8em;border-radius:8px;font-size:14px;white-space:nowrap}
  a.bring.big{display:block;margin:22px 0 0;text-align:center;padding:.8em;font-size:1rem}
  footer{margin-top:2.6em;color:#b3b3b3;font-size:12px}
</style>
</head>
<body>
<main>
  <a class="back" href="{{ root_rel }}">&larr; Alle Wochen</a>
  <h1>Woche {{ week }} &middot; {{ year }}</h1>
  <ul class="cards">
  {% for it in items %}
    <li>
      <a class="title" href="{{ it.filename }}">{{ it.icon }} {{ it.name }}</a>
      <span class="d">{{ it.date }} &middot; {{ it.total }} min</span>
      <a class="bring" href="{{ it.deeplink }}">&#128722; Bring!</a>
    </li>
  {% endfor %}
  </ul>
  {% if week_deeplink %}
  <a class="bring big" href="{{ week_deeplink }}">&#128722; Ganze Woche zu Bring! hinzuf&uuml;gen</a>
  {% endif %}
  <footer>Generiert {{ built }}</footer>
</main>
</body>
</html>
