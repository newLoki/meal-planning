<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Woche {{ week }} &middot; {{ year }}</title>
<style>
  :root{--fg:#1a1a1a;--muted:#6b6b6b;--accent:#338a7e;--card:#f5f4f1;--line:#e6e5e2}
  *{box-sizing:border-box}
  body{margin:0;font:16px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;color:var(--fg);background:#fff}
  main{max-width:640px;margin:0 auto;padding:24px 20px 72px}
  a.back{color:var(--muted);text-decoration:none;font-size:14px}
  h1{font-size:1.5rem;margin:.5em 0 1em}

  ol.cal{list-style:none;padding:0;margin:0}
  ol.cal li.day{display:flex;gap:12px;align-items:stretch;border:1px solid var(--line);border-radius:12px;margin:0 0 8px;padding:10px 12px;min-height:56px}
  ol.cal li.day .dt{flex:0 0 52px;display:flex;flex-direction:column;justify-content:center;text-align:center;border-right:1px solid var(--line);padding-right:10px}
  ol.cal li.day .dt .wd{font-weight:700;font-size:.9rem}
  ol.cal li.day .dt .dn{color:var(--muted);font-size:12px}
  ol.cal li.day .bd{flex:1 1 auto;display:flex;flex-direction:column;justify-content:center;gap:6px;min-width:0}
  ol.cal li.day .rec{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  ol.cal li.day .rec .meal{flex:0 0 auto;color:var(--muted);font-size:12px;font-weight:600;background:var(--card);border-radius:6px;padding:1px 7px;white-space:nowrap}
  ol.cal li.day .rec .title{font-weight:600;color:var(--fg);text-decoration:none;font-size:1.02rem}
  ol.cal li.day .none{color:#c4c3bf}
  ol.cal li.day.empty{background:var(--card);border-color:transparent}
  ol.cal li.day.empty .dt{border-right-color:#dedcd7}
  ol.cal li.day.empty .dt .wd{color:#b7b6b2}
  ol.cal li.day.today{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}

  .acts{margin-left:auto;display:flex;gap:6px}
  a.btn{display:inline-flex;align-items:center;gap:.4em;color:#fff;text-decoration:none;font-weight:600;border-radius:8px;padding:.35em .6em .35em .35em;font-size:13px;white-space:nowrap}
  a.btn .ico{display:inline-flex;align-items:center;justify-content:center;background:#fff;border-radius:6px;padding:2px 4px;font-size:16px;line-height:1}
  a.bring{background:var(--accent)}
  a.gcal{background:#1a73e8}
  a.bring.big{display:flex;margin:22px 0 0;justify-content:center;padding:.8em;font-size:1rem}
  footer{margin-top:2.6em;color:#b3b3b3;font-size:12px}
</style>
</head>
<body>
<main>
  <a class="back" href="{{ root_rel }}">&larr; Alle Wochen</a>
  <h1>Woche {{ week }} &middot; {{ year }}</h1>
  <ol class="cal">
  {% for d in days %}
    <li class="day{% if not d.active %} empty{% endif %}{% if d.is_today %} today{% endif %}">
      <div class="dt"><span class="wd">{{ d.wd }}</span><span class="dn">{{ d.label }}</span></div>
      <div class="bd">
      {% if d.recipes %}
        {% for it in d.recipes %}
        <div class="rec">
          {% if it.meal_label %}<span class="meal">{{ it.meal_label }}{% if it.start_str %} &middot; {{ it.start_str }}{% endif %}</span>{% endif %}
          <a class="title" href="{{ it.filename }}">{{ it.icon }} {{ it.name }}</a>
          <span class="acts">
            <a class="btn bring" href="{{ it.deeplink }}"><span class="ico">&#128722;</span> Bring!</a>
            {% if it.gcal_link %}<a class="btn gcal" href="{{ it.gcal_link }}" target="_blank" rel="noopener"><span class="ico">&#128197;</span> Kalender</a>{% endif %}
          </span>
        </div>
        {% endfor %}
      {% else %}
        <span class="none">&ndash;</span>
      {% endif %}
      </div>
    </li>
  {% endfor %}
  </ol>
  {% if week_deeplink %}
  <a class="btn bring big" href="{{ week_deeplink }}"><span class="ico">&#128722;</span> Ganze Woche zu Bring! hinzuf&uuml;gen</a>
  {% endif %}
  <footer>Generiert {{ built }}</footer>
</main>
</body>
</html>
